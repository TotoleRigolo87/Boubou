<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Valentine 💘</title>
  <style>
    body{
      margin:0; min-height:100vh; display:grid; place-items:center;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      background: #ffe6ee;
    }
    .card{
      width:min(520px, 92vw);
      background:white;
      border-radius:18px;
      padding:24px;
      text-align:center;
      box-shadow: 0 18px 50px rgba(0,0,0,.15);
    }
    .arena{
      position:relative;
      height:120px;
      margin-top:16px;
      display:flex;
      align-items:center;
      justify-content:center;
      gap:12px;
    }
    button{
      border:0;
      padding:12px 18px;
      border-radius:999px;
      font-size:18px;
      cursor:pointer;
      box-shadow: 0 10px 22px rgba(0,0,0,.12);
    }
    #yes{ background:#ff3b6b; color:#fff; }
    #no{
      position:absolute;
      left:60%;
      top:50%;
      transform: translate(-50%,-50%);
      background:#f3f3f3;
      color:#111;
    }
    #result{ margin-top:14px; font-size:20px; font-weight:700; color:#ff2e63; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Veux-tu être ma Valentine ? 💘</h1>
    <p>Choisis bien 😅</p>

    <div class="arena" id="arena">
      <button id="yes">Oui 😍</button>
      <button id="no">Non 🙃</button>
    </div>

    <div id="result"></div>

    <noscript>
      <p style="color:#b00; font-weight:700;">
        Active JavaScript pour que le bouton "Non" puisse fuir 😄
      </p>
    </noscript>
  </div>

  <script>
    window.addEventListener("DOMContentLoaded", () => {
      const arena = document.getElementById("arena");
      const noBtn = document.getElementById("no");
      const yesBtn = document.getElementById("yes");
      const result = document.getElementById("result");

      if (!arena || !noBtn || !yesBtn || !result) {
        document.body.innerHTML = "<p>Erreur: éléments introuvables dans la page.</p>";
        return;
      }

      function moveNo() {
        const a = arena.getBoundingClientRect();
        const b = noBtn.getBoundingClientRect();
        const pad = 8;

        const maxX = Math.max(pad, a.width - b.width - pad);
        const maxY = Math.max(pad, a.height - b.height - pad);

        const x = pad + Math.random() * (maxX - pad);
        const y = pad + Math.random() * (maxY - pad);

        noBtn.style.left = x + "px";
        noBtn.style.top = y + "px";
        noBtn.style.transform = "translate(0,0)";
      }

      noBtn.addEventListener("mouseenter", moveNo);
      noBtn.addEventListener("touchstart", (e) => { e.preventDefault(); moveNo(); }, { passive:false });

      yesBtn.addEventListener("click", () => {
        result.textContent = "YESSS ❤️ Bonne Saint-Valentin 😭💘";
        noBtn.style.display = "none";
        yesBtn.disabled = true;
        yesBtn.textContent = "💞";
      });

      moveNo();
    });
  </script>
</body>
</html>
